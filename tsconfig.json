{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"],
			"@styles/*": ["./styles/*"],
			"@data": ["./data"],
			"@data/*": ["./data/*"],
			"@templates": ["./templates"],
			"@templates/*": ["./templates/*"],
			"@i18n": ["./i18n"]
		}
	},
	"include": [
		"vite.config.ts",
		"vite-env.d.ts",
		"src",
		"styles",
		"data",
		"templates",
		"i18n",
		"tests"
	]
}
